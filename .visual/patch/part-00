+
+/* Final visual polish — the contextual island stays quiet until intent exists. */
+@media (max-width: 680px) {
+  .shop-mobile-shell[data-mobile-chrome-mode="compact"][data-context-action-visible="false"]
+  .shop-mobile-composition {
+    gap: 10px;
+    grid-template-columns: 58px 58px;
+    margin-inline: auto;
+    max-width: 126px;
+    width: 126px;
+  }
+
+  .shop-mobile-shell[data-mobile-chrome-mode="compact"][data-context-action-visible="false"]
+  .shop-mobile-context {
+    display: none;
+  }
+
+  .shop-mobile-shell[data-mobile-chrome-mode="compact"][data-context-action-visible="false"]
+  .shop-mobile-fab {
+    grid-column: 2;
+  }
+
+  .shop-mobile-shell[data-mobile-chrome-mode="compact"][data-context-action-visible="true"]
+  .shop-mobile-context {
+    animation: juw-context-action-enter var(--juw-motion-state) var(--juw-ease-focus) both;
+  }
+}
+
+@media (max-width: 379px) {
+  .shop-mobile-shell[data-mobile-chrome-mode="compact"][data-context-action-visible="false"]
+  .shop-mobile-composition {
+    gap: 6px;
+    grid-template-columns: 50px 50px;
+    max-width: 106px;
+    width: 106px;
+  }
+}
+
+@keyframes juw-context-action-enter {
+  from {
+    opacity: 0;
+    transform: translate3d(0, 8px, 0) scale(0.985);
+  }
+  to {
+    opacity: 1;
+    transform: translate3d(0, 0, 0) scale(1);
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .shop-mobile-shell[data-context-action-visible="true"] .shop-mobile-context {
+    animation: none;
+  }
+}
