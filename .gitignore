# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/.output/
/out/
*.tsbuildinfo

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.inspect.ndjson

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# Optional local Neon CLI/context state. Never commit provider credentials.
/.neon
/.neon/

/dist/
/.wrangler/
/outputs/
/work/
/.tmp/

# Generated centered-logo social derivatives; rebuild with npm run brand:generate:social.
/public/brand/social-profile.png
/public/brand/social-og.png
/design/identity-2026/exports/social-profile-1080.png
/design/identity-2026/exports/social-og-1122x1402.png

# Local duplicate exports created by macOS Save As; canonical flow PNGs omit the suffix.
/docs/order-flows/* 2.png

# Local Codex task state and private workspace topology.
/.codex/

# Local browser-verification output and screenshots.
/.playwright-mcp/
/juw-intake-*.png
/studio-*.png

# Private identity and garment source material. Never commit or deploy.
/storage/
