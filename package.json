{
  "name": "justurbanwears",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/generate-brand-assets.mjs && node scripts/generate-social-brand-assets.mjs && node scripts/shop-db/catalogue.mjs assets && node scripts/shop-media/blob-sync.mjs pull || true",
    "dev": "next dev",
    "prebuild": "node scripts/generate-brand-assets.mjs && node scripts/generate-social-brand-assets.mjs && node scripts/shop-db/catalogue.mjs assets && node scripts/shop-media/blob-sync.mjs pull || true",
    "build": "next build",
    "postbuild": "node scripts/fix-vercel-output-routes.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "env:check": "node scripts/validate-release-env.mjs --template",
    "env:check:runtime": "node scripts/validate-release-env.mjs --runtime",
    "env:check:release": "node scripts/validate-release-env.mjs --release",
    "test": "npm run build && node --test tests/rendered-html.test.mjs tests/metadata-contract.test.mjs",
    "test:rendered": "node --test tests/rendered-html.test.mjs tests/metadata-contract.test.mjs",
    "test:brand": "node --test tests/brand-assets.test.mjs tests/brand-role-contract.test.mjs",
    "test:contracts": "tsx --test tests/*.test.ts",
    "test:shop": "tsx --test tests/shop-checkout-flow.test.ts",
    "test:shop-models": "tsx --test tests/shop-model-assets.test.ts",
    "test:shop-coral-views": "tsx --test tests/shop-coral-model-views.test.ts",
    "test:shop-runtime": "tsx --test tests/shop-runtime-catalog.test.ts",
    "test:shop-db-release": "tsx --test tests/shop-db-release.test.ts tests/shop-juw014-release.test.ts",
    "verify": "npm run env:check && npm run lint && npm run typecheck && npm run test:brand && npm run test:contracts && npm run build && npm run test:rendered",
    "smoke:production": "node scripts/smoke-deployment.mjs https://www.justurbanwears.com",
    "shop:db:generate": "drizzle-kit generate --config drizzle.shop.config.ts",
    "shop:db:migrate": "drizzle-kit migrate --config drizzle.shop.config.ts",
    "shop:db:sync": "node scripts/shop-db/catalogue.mjs sync",
    "shop:db:verify": "node scripts/shop-db/catalogue.mjs verify",
    "shop:db:import-media": "node scripts/shop-db/catalogue.mjs assets",
    "shop:db:publish": "node scripts/shop-db/catalogue.mjs publish",
    "shop:release": "node scripts/shop-db/release.mjs",
    "shop:release:dry-run": "node scripts/shop-db/release.mjs --dry-run",
    "shop:media:push": "node scripts/shop-media/blob-sync.mjs push",
    "shop:media:pull": "node scripts/shop-media/blob-sync.mjs pull"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^3.0.2",
    "@ai-sdk/openai": "^3.0.35",
    "@neondatabase/auth": "^0.1.0-beta.17",
    "@neondatabase/serverless": "^1.0.2",
    "@radix-ui/react-slot": "^1.2.4",
    "@vercel/analytics": "^1.6.1",
    "@vercel/blob": "^1.1.1",
    "ai": "^4.3.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.7",
    "geist": "^1.7.0",
    "lucide-react": "^0.468.0",
    "mapbox-gl": "^3.17.0",
    "next": "^16.0.10",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0",
    "vinext": "^0.0.21",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.0.10",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/vite": "^4.1.16",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.1",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9",
    "eslint-config-next": "^16.0.10",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^7.2.2",
    "vite-plugin-image-presets": "^0.5.2",
    "vite-plugin-static-copy": "^3.1.2"
  },
  "overrides": {
    "@vitejs/plugin-react": "^5.1.1",
    "vite": "^7.2.2"
  }
}
