{
  "name": "justurban-wears",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "npm run brand:generate:social",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "prebuild": "npm run brand:generate:social",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "prebuild:vercel": "npm run brand:generate:social",
    "build:vercel": "NITRO_PRESET=vercel vite build && node scripts/fix-vercel-output-routes.mjs && node scripts/stamp-service-worker.mjs",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "brand:generate": "node scripts/generate-brand-assets.mjs && node scripts/generate-brand-motion-assets.mjs",
    "brand:generate:motion": "node scripts/generate-brand-motion-assets.mjs",
    "brand:generate:social": "node scripts/generate-social-brand-assets.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .output --ignore-pattern .vercel --ignore-pattern '.next-stale-*'",
    "typecheck": "tsc --noEmit -p tsconfig.release.json",
    "env:check": "node scripts/validate-release-env.mjs --template",
    "env:check:runtime": "node scripts/validate-release-env.mjs --runtime",
    "env:check:release": "node scripts/validate-release-env.mjs --release",
    "test": "npm run build && node --test tests/rendered-html.test.mjs tests/metadata-contract.test.mjs tests/brand-entrance.test.mjs tests/service-worker-release-stamp.test.mjs",
    "test:rendered": "node --test tests/rendered-html.test.mjs tests/metadata-contract.test.mjs tests/brand-entrance.test.mjs tests/service-worker-release-stamp.test.mjs",
    "test:experience": "node scripts/verify-experience-build.mjs",
    "test:brand": "npm run brand:generate:social && npm run brand:generate:motion && node --test tests/brand-assets.test.mjs tests/brand-role-contract.test.mjs tests/brand-motion.test.mjs",
    "test:contracts": "tsx --test tests/*.test.ts",
    "test:shop-runtime": "tsx --test tests/shop-runtime-catalog.test.ts",
    "test:shop-db-release": "node --test tests/shop-db-release.test.ts",
    "test:atelier": "node --test tests/virtual-atelier-operation-validator.test.mjs tests/virtual-atelier-portability.test.mjs",
    "verify": "npm run env:check && npm run lint && npm run typecheck && npm run test:brand && npm run test:contracts && npm run test:atelier && npm run build && npm run test:experience && npm run test:rendered",
    "smoke:production": "node scripts/smoke-deployment.mjs https://www.justurbanwears.com",
    "smoke:experience": "node scripts/smoke-experience.mjs https://www.justurbanwears.com",
    "db:generate": "drizzle-kit generate",
    "db:generate:shop": "drizzle-kit generate --config=drizzle.shop.config.ts",
    "db:release:shop": "node scripts/shop-db/shop-release.mjs",
    "db:seed:shop": "node scripts/shop-db/catalogue.mjs seed",
    "db:verify:shop": "node scripts/shop-db/catalogue.mjs verify",
    "db:sync:catalog": "node scripts/shop-db/catalogue.mjs descriptive-sync",
    "db:shop:release:check": "node scripts/shop-db/release.mjs check",
    "db:shop:release:apply": "node scripts/shop-db/shop-release.mjs",
    "db:shop:seed": "node scripts/shop-db/catalogue.mjs seed",
    "db:shop:verify": "node scripts/shop-db/catalogue.mjs verify",
    "db:shop:sync:descriptive": "node scripts/shop-db/catalogue.mjs descriptive-sync",
    "shop:release:dry-run": "node scripts/shop-db/release.mjs check",
    "shop:db:verify": "node scripts/shop-db/catalogue.mjs verify",
    "blob:sync:shop": "node scripts/shop-media/blob-sync.mjs --summary",
    "blob:sync:lulu-v4-authority": "node scripts/studio-models/sync-lulu-v4-authority.mjs",
    "atelier:monitor:room": "node scripts/virtual-atelier/monitor-room-plate.mjs",
    "atelier:verify:operation": "node scripts/virtual-atelier/validate-operation.mjs",
    "atelier:verify:portable": "node scripts/virtual-atelier/verify-portable-bundle.mjs",
    "atelier:export:shop-media": "node scripts/virtual-atelier/export-shop-media.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bodoni-moda": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@mapbox/search-js-react": "^1.5.0",
    "@neondatabase/auth": "0.5.0-beta",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.0",
    "ai": "^7.0.62",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.31.0",
    "mapbox-gl": "^3.28.0",
    "nitro": "^3.0.260610-beta",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "^0.34.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "6.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
