{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "incremental": false
  },
  "include": [
    "next-env.d.ts",
    "types/**/*.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "hooks/**/*.ts",
    "hooks/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "db/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".next",
    "tests",
    "worker",
    "db/index.ts",
    "**/* 2.ts",
    "**/* 2.tsx",
    "**/* 2.mts",
    "**/* 3.ts",
    "**/* 3.tsx",
    "**/* 3.mts"
  ]
}
