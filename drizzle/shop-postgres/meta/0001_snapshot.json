      "checkConstraints": {
        "shop_inventory_counts_nonnegative": {
          "name": "shop_inventory_counts_nonnegative",
          "value": "\n    \"shop_inventory\".\"on_hand\" >= 0\n    and \"shop_inventory\".\"reserved\" >= 0\n    and \"shop_inventory\".\"sold\" >= 0\n    and \"shop_inventory\".\"returned\" >= 0\n    and \"shop_inventory\".\"write_off\" >= 0\n  "
        },
        "shop_inventory_reserved_within_on_hand": {
          "name": "shop_inventory_reserved_within_on_hand",
          "value": "\"shop_inventory\".\"reserved\" <= \"shop_inventory\".\"on_hand\""
        },
        "shop_inventory_returns_within_sales": {
          "name": "shop_inventory_returns_within_sales",
          "value": "\"shop_inventory\".\"returned\" <= \"shop_inventory\".\"sold\""
        },
        "shop_inventory_one_off_conservation": {
          "name": "shop_inventory_one_off_conservation",
          "value": "\n    \"shop_inventory\".\"on_hand\" + \"shop_inventory\".\"sold\" - \"shop_inventory\".\"returned\" + \"shop_inventory\".\"write_off\" = 1\n  "
        },
        "shop_inventory_availability_consistent": {
          "name": "shop_inventory_availability_consistent",
          "value": "\n    (\"shop_inventory\".\"availability\" = 'AVAILABLE' and \"shop_inventory\".\"on_hand\" = 1 and \"shop_inventory\".\"reserved\" = 0)\n    or (\"shop_inventory\".\"availability\" = 'RESERVED' and \"shop_inventory\".\"on_hand\" = 1 and \"shop_inventory\".\"reserved\" = 1)\n    or (\"shop_inventory\".\"availability\" = 'SOLD' and \"shop_inventory\".\"on_hand\" = 0 and \"shop_inventory\".\"reserved\" = 0 and \"shop_inventory\".\"sold\" > \"shop_inventory\".\"returned\")\n    or (\"shop_inventory\".\"availability\" = 'ARCHIVED' and \"shop_inventory\".\"reserved\" = 0)\n  "
        }
      },
      "isRLSEnabled": false
    },
