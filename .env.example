# Public, URL-restricted Mapbox token for checkout location search and preview.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Server-only Neon credentials. Runtime uses the pooled URL. Shop release tools
# accept only DATABASE_URL_UNPOOLED (or Vercel's POSTGRES_URL_NON_POOLING alias).
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Required safety labels for every shop database command. The expected host and
# database must exactly match the direct URL. Use a distinct Neon branch host
# for preview. Production writes also require the confirmation value documented
# in docs/data/SHOP_DATABASE.md.
SHOP_DB_TARGET=local
SHOP_DB_EXPECTED_HOST=
SHOP_DB_EXPECTED_DATABASE=
SHOP_DB_PRODUCTION_CONFIRM=
# Required for production writes: copy the checksum printed by a locally
# validated manifest. Optional but enforced when set for other targets.
SHOP_DB_EXPECTED_MANIFEST_CHECKSUM=
# Optional CI override; otherwise release writes record the current git HEAD.
SHOP_DB_GIT_SHA=

# Server-only Vercel Blob credentials for the two connected stores.
PUBLIC_BLOB_READ_WRITE_TOKEN=
PRIVATE_BLOB_READ_WRITE_TOKEN=

# Customer return window, counted from the recorded delivery or collection.
# Valid values are whole days from 1 through 90; unset/invalid values use 7.
SHOP_RETURN_WINDOW_DAYS=7

# Customer-facing commerce guidance. Checkout fails closed until the three
# bank-transfer values are present. Support, pickup, return and tracking values
# are shown only when configured; never put account secrets in NEXT_PUBLIC_*.
SHOP_PAYMENT_BANK_NAME=
SHOP_PAYMENT_ACCOUNT_NAME=
SHOP_PAYMENT_ACCOUNT_NUMBER=
SHOP_CUSTOMER_SUPPORT_EMAIL=
SHOP_CUSTOMER_SUPPORT_PHONE=
SHOP_PICKUP_LOCATION=
SHOP_PICKUP_CONTACT=
SHOP_RETURN_HANDOFF_LOCATION=
SHOP_RETURN_HANDOFF_CONTACT=
SHOP_RETURN_HANDOFF_INSTRUCTIONS=
SHOP_TRACKING_URL_TEMPLATE=

# Transactional order email. The from address must use a verified Resend
# domain. Durable outbox rows remain retryable when these values are absent.
RESEND_API_KEY=
SHOP_NOTIFICATION_FROM_EMAIL=
SHOP_PUBLIC_ORIGIN=https://www.justurbanwears.com

# Private Studio AI engine. Leave the auth mode unset on hosts that do not
# provide authenticated OpenAI/Sites user headers. Operator emails are
# comma-separated and checked only on the server. Connected order finance also
# requires an active, explicit `admin` row in studio_operator_membership.
STUDIO_AI_ENGINE_AUTH_MODE=
STUDIO_OPERATOR_EMAILS=
STUDIO_AI_TEXT_MODEL=zai/glm-4.6v-flash
# These values mirror the code-owned, fail-closed image policy. Runtime may not
# select another provider/model or widen the approved per-image cost cap.
STUDIO_AI_IMAGE_MODEL=openai/gpt-image-2
STUDIO_AI_IMAGE_COST_CAP_USD=0.10

# Full international WhatsApp number for order handoff (digits only, no leading +).
# Leave blank to keep the existing local order-status flow.
SHOP_WHATSAPP_ORDER_NUMBER=
